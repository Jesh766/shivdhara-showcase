{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "data/**"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=(self)" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.clarity.ms https://*.clarity.ms https://c.bing.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://images.unsplash.com https://www.clarity.ms https://*.clarity.ms https://c.bing.com https://*.bing.com; connect-src 'self' https://api.emailjs.com https://www.clarity.ms https://*.clarity.ms https://c.bing.com https://*.bing.com; object-src 'none'; base-uri 'self'; form-action 'self';"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/editor", "destination": "/api/editor" },
    { "source": "/api/editor/(.*)", "destination": "/api/editor?path=$1" },
    { "source": "/api/chat", "destination": "/api/chat" },
    { "source": "/api/admin", "destination": "/api/admin" },
    { "source": "/api/admin/(.*)", "destination": "/api/admin" },
    { "source": "/api/users", "destination": "/api/users" },
    { "source": "/api/users/(.*)", "destination": "/api/users" },
    { "source": "/api/consultations", "destination": "/api/consultations" },
    { "source": "/api/consultations/(.*)", "destination": "/api/consultations" },
    { "source": "/api/orders", "destination": "/api/orders" },
    { "source": "/api/workshops", "destination": "/api/workshops" },
    { "source": "/api/workshops/(.*)", "destination": "/api/workshops" },
    { "source": "/api/products", "destination": "/api/products" },
    { "source": "/api/products/(.*)", "destination": "/api/products" },
    { "source": "/api/human-request", "destination": "/api/human-request" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
